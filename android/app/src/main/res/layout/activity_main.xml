<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- PAGE 1: Giới thiệu -->
    <include
        android:id="@+id/layoutPage1"
        layout="@layout/layout_page1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- PAGE 2: Chọn gói chụp (Bước 1/3) -->
    <include
        android:id="@+id/layoutPage2"
        layout="@layout/layout_page2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- PAGE 3: Mã giảm giá & Số lượng (Bước 2/3) -->
    <include
        android:id="@+id/layoutPage3"
        layout="@layout/layout_page3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- PAGE METHOD: Chọn phương thức thanh toán -->
    <include
        android:id="@+id/layoutPageMethod"
        layout="@layout/layout_page_method"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- PAGE 4: Thanh toán QR / Tiền mặt (Bước 3/3) -->
    <include
        android:id="@+id/layoutPage4"
        layout="@layout/layout_page4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- PAGE 5: Thanh toán thành công (Cảm ơn) -->
    <include
        android:id="@+id/layoutPage5"
        layout="@layout/layout_page5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ========================================================
         VÙNG VÔ HÌNH: LOGO GÓC TRÊN CÙNG (PHẢI & TRÁI)
         - Nhấn giữ lâu: mở PIN chẩn đoán (nhân viên)
         - Nhấn ở Page 5: quay lại Page 1 ngay lập tức
         ======================================================== -->
    <View
        android:id="@+id/viewStaffSecret"
        android:layout_width="220dp"
        android:layout_height="90dp"
        android:layout_gravity="top|end"
        android:background="@drawable/btn_transparent_ripple"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:id="@+id/viewStaffSecretLeft"
        android:layout_width="200dp"
        android:layout_height="90dp"
        android:layout_gravity="top|start"
        android:background="@drawable/btn_transparent_ripple"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
