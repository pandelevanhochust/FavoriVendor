<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:title="Thanh toán"
            android:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- ============ MÀN 1: CHỌN SỐ TIỀN ============ -->
            <LinearLayout
                android:id="@+id/layoutHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn mức giá"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPrice1"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_choice"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="#1565C0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="80.000 VND" />

                <TextView
                    android:id="@+id/tvPrice2"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_choice"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="#1565C0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="100.000 VND" />

                <TextView
                    android:id="@+id/tvPrice3"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_choice"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="#1565C0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="200.000 VND" />

                <TextView
                    android:id="@+id/tvHomeMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="Thông báo" />

            </LinearLayout>

            <!-- ============ MÀN 2: CHỌN PHƯƠNG THỨC ============ -->
            <LinearLayout
                android:id="@+id/layoutMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvMethodAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Số tiền: 1.000 VND" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chọn hình thức thanh toán"
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvMethodCash"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_choice"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Tiền mặt"
                    android:textColor="#1565C0"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCashHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="#EF6C00"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Máy nhận tiền chưa sẵn sàng" />

                <TextView
                    android:id="@+id/tvMethodTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_choice"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Chuyển khoản"
                    android:textColor="#1565C0"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMethodMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="Thông báo lỗi" />

                <TextView
                    android:id="@+id/tvBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:text="← Chọn lại mức giá"
                    android:textColor="#1565C0"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- ============ CHUYỂN KHOẢN: HIỆN QR ============ -->
            <LinearLayout
                android:id="@+id/layoutQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quét mã để thanh toán"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQrAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="1.000 VND" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:layout_margin="16dp"
                        android:contentDescription="Mã VietQR" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvQrStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        tools:text="Đang chờ thanh toán..." />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    tools:text="Mã còn hiệu lực: 04:52" />

                <TextView
                    android:id="@+id/tvOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    tools:text="Mã đơn: ABCD2345EFGH" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Huỷ / Chọn lại" />

            </LinearLayout>

            <!-- ============ TIỀN MẶT: CHỜ BỎ TIỀN ============ -->
            <LinearLayout
                android:id="@+id/layoutCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vui lòng cho tiền vào khe nhận tiền"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCashAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="18sp"
                    tools:text="Cần thanh toán: 2.000 VND" />

                <TextView
                    android:id="@+id/tvCashInserted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#2E7D32"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Đã nhận: 1.000 VND" />

                <TextView
                    android:id="@+id/tvCashRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="Còn thiếu: 1.000 VND" />

                <TextView
                    android:id="@+id/tvCashMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="#EF6C00"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="Thông báo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Máy không thối tiền. Chỉ nhận tờ có mệnh giá không vượt quá số tiền còn thiếu."
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCashCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Huỷ" />

            </LinearLayout>

            <!-- ============ KẾT QUẢ ============ -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResultIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="96sp"
                    tools:text="✓" />

                <TextView
                    android:id="@+id/tvResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Thanh toán thành công" />

                <TextView
                    android:id="@+id/tvResultMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    tools:text="Cảm ơn quý khách" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="40dp"
                    android:text="Xong" />

            </LinearLayout>

        </FrameLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
