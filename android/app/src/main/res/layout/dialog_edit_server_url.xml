<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cài Đặt Server URL"
            android:textColor="#850000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Thay đổi địa chỉ máy chủ API backend của hệ thống Kiosk"
            android:textColor="#757575"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Địa chỉ Server URL (kiosk.serverUrl) *"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="https://api.yourdomain.com/ hoặc http://192.168.1.x:5000/"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="* Phải bắt đầu bằng http:// hoặc https://. Tự động thêm dấu '/' ở cuối."
            android:textColor="#757575"
            android:textSize="12sp" />

        <!-- Nút Khôi phục mặc định -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDefaultUrl"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="Khôi phục mặc định"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textSize="13sp" />

        <!-- Hàng nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelUrlModal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="#555555"
                app:cornerRadius="8dp"
                app:strokeColor="#CCCCCC" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveServerUrl"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#850000"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
