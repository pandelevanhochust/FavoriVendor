<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chẩn đoán &amp; Quản trị Favori"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Nút Lịch sử giao dịch (SQLite) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTransactions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="Lịch sử giao dịch"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#850000"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconGravity="textStart" />

        <!-- Nút Tạo & Quản lý mã giảm giá -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiscounts"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="Tạo &amp; Quản lý mã giảm giá"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#850000"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_add"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/tvLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <!-- ===== Kết nối ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Kết nối"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Giao thức: ICT106 RS232 (9600, 8 bit, parity chẵn, 1 stop). Máy VND6: DIP SW SETTING 2, SW2 = OFF rồi tắt/bật nguồn."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBaud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Baud"
                android:inputType="number" />

            <Spinner
                android:id="@+id/spParity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1" />

        </LinearLayout>

        <EditText
            android:id="@+id/etVidPid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="VID:PID (tuỳ chọn), vd 1a86:7523"
            android:inputType="text" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swPoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Poll trạng thái 0x0C mỗi 200 ms (khuyến nghị)" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAckCompat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tương thích: gửi 0x8F sau 0x81 (chỉ bật nếu máy dừng sau RX 81)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:backgroundTint="#850000"
            android:textColor="#FFFFFF"
            android:text="Lưu và kết nối lại" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHandshake"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:strokeColor="#850000"
                android:textColor="#850000"
                android:text="Bắt tay thủ công" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:strokeColor="#850000"
                android:textColor="#850000"
                android:text="Reset máy" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etHex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Gửi byte hex, vd: 8F 02"
                android:inputType="text|textCapCharacters" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="#850000"
                android:textColor="#FFFFFF"
                android:text="Gửi" />

        </LinearLayout>

        <!-- ===== Hiệu chuẩn ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. Hiệu chuẩn mệnh giá"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bật chế độ này rồi lần lượt nhét từng loại tiền. Máy sẽ luôn trả lại tờ tiền; bạn gán mệnh giá cho loại vừa nhận diện."
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swCalib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chế độ hiệu chuẩn" />

        <TextView
            android:id="@+id/tvLastBill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="Loại tờ tiền vừa nhận diện: (chưa có)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFillVnd6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeColor="#850000"
            android:textColor="#850000"
            android:text="Điền gợi ý VND6: 0x40..0x45 = 10k, 20k, 50k, 100k, 200k, 500k" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etVnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Mệnh giá VND của loại này (0 = không nhận)"
                android:inputType="number" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="#850000"
                android:textColor="#FFFFFF"
                android:text="Lưu" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

        <!-- ===== Phiên tiền mặt ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3. Phiên tiền mặt dang dở"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCashSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearCash"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeColor="#850000"
            android:textColor="#850000"
            android:text="Xoá bản ghi tiền mặt chưa xử lý (sau khi đã đối soát tay)" />

        <!-- ===== Log ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="4. Nhật ký (mới nhất ở trên)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyLog"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:strokeColor="#850000"
                android:textColor="#850000"
                android:text="Sao chép log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLog"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:strokeColor="#850000"
                android:textColor="#850000"
                android:text="Xoá log" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
