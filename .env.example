# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG VIETQR PHOTOBOOTH KIOSK
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị thực tế.
# LƯU Ý: KHÔNG commit tệp .env lên Git!
# =====================================================================

# ---------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU (DATABASE)
# ---------------------------------------------------------------------
# LỰA CHỌN A: Dùng Supabase Cloud PostgreSQL (Khuyên dùng - Không cần chạy container Postgres cục bộ)
# Lấy chuỗi kết nối URI từ Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Hoặc dùng định dạng Npgsql ConnectionString chuẩn của .NET:
ConnectionStrings__Default=Host=aws-0-ap-southeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.[YOUR-PROJECT-REF];Password=[YOUR-PASSWORD];SSL Mode=Require;Trust Server Certificate=true

# LỰA CHỌN B: Dùng PostgreSQL Local Container (Chỉ cần khi chạy docker-compose.yml có service postgres)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=vietqr_kiosk

# ---------------------------------------------------------------------
# 2. TÀI KHOẢN VIETQR PARTNER (Gọi từ Kiosk Server sang VietQR API)
# ---------------------------------------------------------------------
VietQr__BaseUrl=https://dev.vietqr.org/
VietQr__Username=your_vietqr_username
VietQr__Password=your_vietqr_password
VietQr__BankCode=MB
VietQr__BankAccount=your_bank_account_number
VietQr__AccountName=TEN CHU TAI KHOAN

# ---------------------------------------------------------------------
# 3. WEBHOOK CALLBACK (VietQR gọi ngược vào server khi có tiền về)
# ---------------------------------------------------------------------
Callback__BasePath=vietqr
Callback__Username=your_chosen_callback_username
Callback__Password=your_chosen_callback_password
# Chuỗi bí mật >= 32 ký tự để mã hóa token JWT (ví dụ: openssl rand -base64 48)
Callback__JwtSecret=your_random_jwt_secret_at_least_32_characters_long

# ---------------------------------------------------------------------
# 4. KIOSK ANDROID CLIENT SECURITY
# ---------------------------------------------------------------------
# Khóa bí mật cho app Android Kiosk kết nối backend (>= 16 ký tự, ví dụ: openssl rand -hex 24)
Kiosk__ApiKey=your_random_kiosk_api_key_at_least_16_characters
Kiosk__OrderTtlSeconds=300

# ---------------------------------------------------------------------
# 5. TẦNG LƯU TRỮ TÀI NGUYÊN (Storage: Frames, Layouts, Filters, Photos, Videos)
# ---------------------------------------------------------------------
# Đang sử dụng Cloudflare R2:
Storage__Provider=CloudflareR2

# Cấu hình Cloudflare R2 Bucket favori:
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=favori
Storage__R2__PublicDomain=

# (Dự phòng nếu chuyển sang Local Disk):
Storage__Local__BaseDirectory=data/uploads
Storage__Local__PublicBaseUrl=/uploads

# ---------------------------------------------------------------------
# 6. GIAO DIỆN QUẢN TRỊ CMS (Next.js fe-cms)
# ---------------------------------------------------------------------
CMS_PORT=3002
# Địa chỉ Backend mà trình duyệt của bạn có thể gọi tới (ví dụ http://localhost:8080 hoặc https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http:/<IP>:5000
