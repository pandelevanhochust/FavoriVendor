# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.
# Dấu "__" biểu thị cấp lồng: Mqtt__Host tương ứng cấu hình Mqtt:Host.

# --- Kết nối MQTT tới VietQR (VietQR cung cấp sau khi đăng ký) ---
Mqtt__Host=
Mqtt__Port=8883
Mqtt__UseTls=true
Mqtt__Username=
Mqtt__Password=
# Cố định và DUY NHẤT cho mỗi tiến trình server. Hai server dùng chung ClientId sẽ đá nhau liên tục.
Mqtt__ClientId=vietqr-kiosk-server

# --- Điểm bán và tài khoản nhận tiền ---
# Nếu VietQR đã cấp terminalCode thì điền ở đây. Nếu chưa, để trống TerminalCode/BankAccount/AccountName
# và dùng lệnh đồng bộ điểm bán (xem README, mục 2): server sẽ tự lấy và lưu vào data/terminal.json.
Mqtt__TerminalCode=
Mqtt__BankCode=MB
Mqtt__BankAccount=
# Tên chủ tài khoản đúng như đã đăng ký (dùng khi tạo QR và để tính checkSum tra cứu giao dịch)
Mqtt__AccountName=

# --- Chỉ cần khi chạy đồng bộ điểm bán ---
Mqtt__SecretKey=
# Định danh thiết bị do bạn tự đặt, ổn định, không đổi giữa các lần chạy
Mqtt__MacAddr=
Mqtt__SerialNumber=

# --- Khoá cho app Android (>= 16 ký tự), ví dụ: openssl rand -hex 24 ---
Kiosk__ApiKey=
Kiosk__OrderTtlSeconds=300

# --- Khoá API quản trị (>= 16 ký tự). ĐỂ TRỐNG = tắt hoàn toàn /admin/... (khuyến nghị sau khi đồng bộ xong) ---
Admin__ApiKey=

# --- Cơ sở dữ liệu PostgreSQL ---
POSTGRES_USER=kiosk_user
POSTGRES_PASSWORD=kiosk_secret_pass
POSTGRES_DB=vietqr_kiosk
ConnectionStrings__Default=Host=postgres;Port=5432;Database=vietqr_kiosk;Username=kiosk_user;Password=kiosk_secret_pass
