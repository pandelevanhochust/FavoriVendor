# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.

# --- Cấu hình PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vietqr_kiosk
ConnectionStrings__Default=Host=db;Port=5432;Database=vietqr_kiosk;Username=postgres;Password=postgres

# --- Tài khoản VietQR cấp cho bạn (gọi từ server sang VietQR) ---
VietQr__BaseUrl=https://dev.vietqr.org/
VietQr__Username=
VietQr__Password=
VietQr__BankCode=MB
VietQr__BankAccount=
VietQr__AccountName=

# --- Do BẠN tự đặt, rồi gửi cho VietQR khi đăng ký (VietQR gọi ngược vào server qua API Callback, KHÔNG DÙNG MQTT) ---
Callback__BasePath=vietqr
Callback__Username=
Callback__Password=
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: openssl rand -base64 48
Callback__JwtSecret=

# --- Khoá cho app Android (>= 16 ký tự), ví dụ: openssl rand -hex 24 ---
Kiosk__ApiKey=
Kiosk__OrderTtlSeconds=300

# --- Tầng lưu trữ Frame & Layout (Local hoặc CloudflareR2) ---
Storage__Provider=Local
Storage__Local__BaseDirectory=data/uploads
Storage__Local__PublicBaseUrl=/uploads

# Nếu dùng Cloudflare R2 (Storage__Provider=CloudflareR2):
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=kiosk-assets
Storage__R2__PublicDomain=https://file.yourdomain.com

# --- Frontend CMS Port ---
CMS_PORT=3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
